<div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
  <table class="table-cv">
    <tbody>
      <tr>
        <td>
          {% if include.label -%}
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle portfolio-date-badge{% if include.badge_class %} {{ include.badge_class }}{% endif %}">
              {{- include.label -}}
            </span>
          {%- endif %}
        </td>
      </tr>
      {% if include.location %}
        <tr>
          <td>
            <p class="location"><i class="fa-solid fa-location-dot iconlocation"></i> {{ include.location }}</p>
          </td>
        </tr>
      {% endif %}
    </tbody>
  </table>
</div>
